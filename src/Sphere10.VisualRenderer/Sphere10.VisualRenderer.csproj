<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Sphere10.VisualRenderer</AssemblyName>
    <RootNamespace>Sphere10.VisualRenderer</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <IsPackable>true</IsPackable>
    <PackageId>Sphere10.VisualRenderer</PackageId>
    <Product>Sphere10 VisualRenderer</Product>
    <Description>Render an independent visual object model to HTML and plain text, using embedded themes and optional asset and template overrides.</Description>
    <PackageTags>sphere10;renderer;html;visual-model;themes</PackageTags>
    <PackageProjectUrl>https://sphere10.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Update="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Update="buildTransitive/Sphere10.VisualRenderer.targets" Pack="true" PackagePath="buildTransitive/Sphere10.VisualRenderer.targets" />
    <None Remove="Themes/default/resources/mathjax/LICENSE" />
    <None Include="Themes/default/resources/mathjax/LICENSE" Pack="true" PackagePath="third-party/MathJax/" />
    <None Include="Themes/.mermaid/resources/mermaid/LICENSE.txt" Pack="true" PackagePath="third-party/Mermaid/" />
    <None Include="Themes/.mermaid/resources/mermaid/DOMPurify-LICENSE.txt" Pack="true" PackagePath="third-party/Mermaid/" />
    <EmbeddedResource Include="Themes/**/*" Exclude="Themes/**/*.cs" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>
  <!-- Source references retain the same legal notices as the NuGet buildTransitive target. -->
  <ItemGroup>
    <None Include="../../LICENSE" Link="licenses/Sphere10.VisualRenderer/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Pack="false" />
    <None Update="THIRD-PARTY-NOTICES.md" Link="licenses/Sphere10.VisualRenderer/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Themes/default/resources/mathjax/LICENSE" Link="licenses/Sphere10.VisualRenderer/third-party/MathJax/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Themes/.mermaid/resources/mermaid/LICENSE.txt" Link="licenses/Sphere10.VisualRenderer/third-party/Mermaid/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Themes/.mermaid/resources/mermaid/DOMPurify-LICENSE.txt" Link="licenses/Sphere10.VisualRenderer/third-party/Mermaid/DOMPurify-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
